# ==========================================
# NG Learn · Nurturing Green .gitignore
# ==========================================

# 1. Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# 2. Production & Build Artifacts
dist/
**/dist/
build/
**/build/
out/
.vite/
**/.vite/

# 3. Duplicate Video Folders (Prevents committing same MP4s twice)
# Note: Canonical videos are maintained in `ng-learn/public/videos/`
courses/**/videos/
ng-learn/courses/**/videos/
**/courses/**/videos/

# 4. Logs & Debug Outputs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Local Environment & Secret Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# 6. Editor & IDE Settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 7. Operating System Cache
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 8. Temporary & Agent Scratch Caches
.tempmediaStorage/
.system_generated/
.agents/
.gemini/
*.tmp
